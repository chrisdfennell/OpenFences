<!-- Dark dialog controls (same look as InputDialog). Merge into a dialog's Window.Resources:
     the implicit styles then apply to that dialog only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Dlg.Bg"        Color="#1B1B20"/>
    <SolidColorBrush x:Key="Dlg.Card"      Color="#26262C"/>
    <SolidColorBrush x:Key="Dlg.CardEdge"  Color="#3B3B46"/>
    <SolidColorBrush x:Key="Dlg.Fg"        Color="#EDEDED"/>
    <SolidColorBrush x:Key="Dlg.Subtle"    Color="#A8AEBD"/>
    <SolidColorBrush x:Key="Dlg.BtnBg"     Color="#2D3547"/>
    <SolidColorBrush x:Key="Dlg.BtnHover"  Color="#38425A"/>
    <SolidColorBrush x:Key="Dlg.BtnPress"  Color="#2A344C"/>
    <SolidColorBrush x:Key="Dlg.BtnBorder" Color="#55607A"/>
    <SolidColorBrush x:Key="Dlg.Accent"    Color="#3B82F6"/>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource Dlg.BtnBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dlg.BtnBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Dlg.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Dlg.BtnPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action (blue) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <!-- Small square icon button (↑ ↓ ✕ ▾) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#3A4453"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#202533"/>
        <Setter Property="BorderBrush" Value="#3A4453"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Dlg.Fg}"/>
    </Style>
</ResourceDictionary>
