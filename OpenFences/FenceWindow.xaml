<Window x:Class="OpenFences.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="True"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Width="420" Height="260">

    <!-- Borderless chrome (resize grips, no caption buttons) -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flat, hover-aware title-bar button (replaces default gray 3D chrome) -->
        <Style x:Key="FenceTitleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C7CBD1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3D44"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4A4E57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A close button that tints red on hover -->
        <Style x:Key="FenceCloseButton" TargetType="Button" BasedOn="{StaticResource FenceTitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Item tile: rounded card that highlights on hover and when selected -->
        <Style x:Key="FenceItemBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Opacity" Value="0.25"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#3354708F"/>
                    <Setter Property="BorderBrush" Value="#5A8FD8"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Root surface: rounded dark card + drop shadow -->
    <Border x:Name="RootBorder"
            Background="#1E1E1E"
            CornerRadius="10"
            BorderBrush="#3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.40" Color="#000000"/>
        </Border.Effect>

        <!-- Darkening/tint layer over a background picture or video (transparent otherwise) -->
        <Border x:Name="MediaLayer" CornerRadius="9" Background="Transparent">
        <Border x:Name="TintLayer" CornerRadius="9" Background="Transparent">
        <DockPanel>

            <!-- Title bar -->
            <!-- Title bar background is a Border whose top corners follow the card's rounding
                 (outer radius 10 minus the 1px edge), so the corners don't poke out square. -->
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    CornerRadius="9,9,0,0"
                    Background="#2B2B2B">
            <Grid Height="34"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  ContextMenuOpening="TitleBar_ContextMenuOpening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LockGlyph"
                               DockPanel.Dock="Right"
                               Text="🔒"
                               FontSize="10"
                               Margin="6,0,0,0"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               ToolTip="Locked: can't be moved or resized"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Foreground="#E0E0E0"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Content="✎"
                            Style="{StaticResource FenceTitleButton}"
                            Width="28" Height="24" Margin="0,0,4,0"
                            ToolTip="Edit / manage fence (rename, sort, delete…)"
                            Click="Edit_Click"/>
                    <Button Content="–"
                            Style="{StaticResource FenceTitleButton}"
                            Width="28" Height="24" Margin="0,0,4,0"
                            Click="Collapse_Click"
                            ToolTip="Collapse / Expand"/>
                    <Button Content="✕"
                            Style="{StaticResource FenceCloseButton}"
                            Width="28" Height="24"
                            Click="Close_Click"
                            ToolTip="Close fence (reopen it from the OpenFences window)"/>
                </StackPanel>

                <!-- Right-click menu on the title bar -->
                <Grid.ContextMenu>
                    <ContextMenu x:Name="FenceMenu">
                        <MenuItem Header="Rename…" Click="Rename_Click"/>
                        <MenuItem Header="Open Folder" Click="OpenFolder_Click"/>
                        <MenuItem x:Name="MiChangeFolder" Header="Change folder…" Click="ChangePortalFolder_Click"/>
                        <MenuItem x:Name="MiAddTab" Header="Add tab…" Click="AddTab_Click"/>
                        <MenuItem x:Name="MiLock" Header="Lock position and size" IsCheckable="True" Click="Lock_Click"/>
                        <Separator/>
                        <MenuItem x:Name="SortMenu" Header="Sort by">
                            <MenuItem Header="Name"          Tag="Name"         IsCheckable="True" Click="Sort_Click"/>
                            <MenuItem Header="Type"          Tag="Type"         IsCheckable="True" Click="Sort_Click"/>
                            <MenuItem Header="Date modified" Tag="DateModified" IsCheckable="True" Click="Sort_Click"/>
                            <MenuItem Header="Size"          Tag="Size"         IsCheckable="True" Click="Sort_Click"/>
                            <MenuItem Header="Manual"        Tag="Manual"       IsCheckable="True" Click="Sort_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="IconSizeMenu" Header="Icon size">
                            <MenuItem Header="Small"  Tag="Small"  IsCheckable="True" Click="IconSize_Click"/>
                            <MenuItem Header="Medium" Tag="Medium" IsCheckable="True" Click="IconSize_Click"/>
                            <MenuItem Header="Large"  Tag="Large"  IsCheckable="True" Click="IconSize_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add System Shortcuts" Click="AddSystemShortcuts_Click"/>
                        <MenuItem x:Name="ColorMenu" Header="Color">
                            <MenuItem Header="Default" Tag="" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#2B2B2B" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Blue" Tag="#3B82F6" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#3B82F6" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Teal" Tag="#14B8A6" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#14B8A6" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Green" Tag="#22C55E" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#22C55E" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Amber" Tag="#F59E0B" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#F59E0B" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Red" Tag="#EF4444" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#EF4444" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Pink" Tag="#EC4899" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#EC4899" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Purple" Tag="#8B5CF6" IsCheckable="True" Click="Color_Click">
                                <MenuItem.Icon><Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#8B5CF6" Stroke="#55607A" StrokeThickness="1"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Custom…" Click="CustomColor_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="TitleSizeMenu" Header="Title size">
                            <MenuItem Header="Small"       Tag="11" IsCheckable="True" Click="TitleSize_Click"/>
                            <MenuItem Header="Normal"      Tag="12" IsCheckable="True" Click="TitleSize_Click"/>
                            <MenuItem Header="Large"       Tag="14" IsCheckable="True" Click="TitleSize_Click"/>
                            <MenuItem Header="Extra large" Tag="16" IsCheckable="True" Click="TitleSize_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="BackgroundMenu" Header="Background">
                            <MenuItem Header="Choose image or video…" Click="ChooseBackground_Click"/>
                            <MenuItem x:Name="MiRemoveBackground" Header="Remove background" Click="RemoveBackground_Click"/>
                            <MenuItem x:Name="MiMuteBackground" Header="Mute video sound" IsCheckable="True" Click="MuteBackground_Click"/>
                            <Separator/>
                            <MenuItem x:Name="BgFitMenu" Header="Fit">
                                <MenuItem Header="Fill (crop to cover)" Tag="Fill"    IsCheckable="True" Click="BackgroundFit_Click"/>
                                <MenuItem Header="Fit (show all)"       Tag="Fit"     IsCheckable="True" Click="BackgroundFit_Click"/>
                                <MenuItem Header="Stretch"              Tag="Stretch" IsCheckable="True" Click="BackgroundFit_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="BgDimMenu" Header="Darken">
                                <MenuItem Header="None"   Tag="0.00" IsCheckable="True" Click="BackgroundDim_Click"/>
                                <MenuItem Header="Light"  Tag="0.20" IsCheckable="True" Click="BackgroundDim_Click"/>
                                <MenuItem Header="Medium" Tag="0.35" IsCheckable="True" Click="BackgroundDim_Click"/>
                                <MenuItem Header="Strong" Tag="0.55" IsCheckable="True" Click="BackgroundDim_Click"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="TransparencyMenu" Header="Transparency">
                            <MenuItem Header="Opaque"             Tag="1.00" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="Slight (90%)"       Tag="0.90" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="Medium (75%)"       Tag="0.75" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="High (60%)"         Tag="0.60" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="Very High (40%)"    Tag="0.40" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="Glass (20%)"        Tag="0.20" IsCheckable="True" Click="Transparency_Click"/>
                            <MenuItem Header="Invisible (0%)"     Tag="0.00" IsCheckable="True" Click="Transparency_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MiGlass" Header="Frosted glass" IsCheckable="True" Click="Glass_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete Fence…" Foreground="#FFEF4444" Click="DeleteFence_Click"/>
                        <Separator/>
                        <MenuItem Header="Close Fence" Click="Close_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
            </Border>

            <!-- Tabs: shown when the fence has two or more (built in code) -->
            <DockPanel x:Name="TabStrip"
                       DockPanel.Dock="Top"
                       Margin="8,6,6,0"
                       Visibility="Collapsed">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource FenceTitleButton}"
                        Width="26" Height="24"
                        Content="+"
                        FontSize="15"
                        ToolTip="Add tab"
                        Click="AddTab_Click"/>
                <WrapPanel x:Name="TabHeaders" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Portal breadcrumbs: shown only after opening a subfolder -->
            <DockPanel x:Name="BreadcrumbBar"
                       DockPanel.Dock="Top"
                       Height="28"
                       Margin="6,4,6,0"
                       Visibility="Collapsed">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource FenceTitleButton}"
                        Width="28" Height="22"
                        Content="‹"
                        FontSize="16"
                        ToolTip="Back (Backspace)"
                        Click="Back_Click"/>
                <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </DockPanel>

            <!-- Items area (with marquee selection overlay). Portal fences only —
                 real-icon fences collapse this to a click-through hole. -->
            <Grid x:Name="ContentArea">
            <ScrollViewer x:Name="Scroller"
              Margin="6"
              Focusable="True"
              VerticalScrollBarVisibility="Auto"
              Background="Transparent"
              PreviewMouseLeftButtonDown="Scroller_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Scroller_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Scroller_PreviewMouseLeftButtonUp"
              CanContentScroll="False"
              PanningMode="None">

                <ItemsControl x:Name="Items" SnapsToDevicePixels="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Tile size follows the fence's icon-size setting -->
                            <WrapPanel ItemWidth="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                       ItemHeight="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Highlight card; width tracks the tile size -->
                            <Border Style="{StaticResource FenceItemBorder}"
                                    Width="{Binding TileContentWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="4,4,4,4"
                                    Padding="4,6,4,4"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTip="{Binding DisplayName}"
                                    MouseLeftButtonDown="Item_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                    MouseMove="Item_MouseMove"
                                    MouseRightButtonDown="Item_MouseRightButtonDown"
                                    MouseRightButtonUp="Item_MouseRightButtonUp"
                                    ContextMenuService.IsEnabled="False">
                                <!-- Fallback when Windows' own menu isn't available (special items) -->
                                <Border.ContextMenu>
                                    <ContextMenu Opened="ItemMenu_Opened">
                                        <MenuItem Header="Open" Click="Item_Open_Click"/>
                                        <MenuItem Header="Quick Look" InputGestureText="Space" Click="Item_QuickLook_Click"/>
                                        <MenuItem Header="Open file location" Click="Item_OpenFolder_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove from fence" Tag="RemoveFromFence" Click="Item_RemoveFromFence_Click"/>
                                        <MenuItem Header="Delete (Recycle Bin)" Click="Item_Delete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Image Width="{Binding IconPx, RelativeSource={RelativeSource AncestorType=Window}}"
                     Height="{Binding IconPx, RelativeSource={RelativeSource AncestorType=Window}}"
                     Source="{Binding Icon}"
                     Stretch="Uniform"
                     SnapsToDevicePixels="True"
                     UseLayoutRounding="True"/>
                                    <!-- Two-line label, like Fences -->
                                    <TextBlock Text="{Binding DisplayName}"
                     Foreground="#EAEAEA"
                     FontSize="11"
                     Margin="0,5,0,0"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     MaxHeight="28"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

                <!-- Marquee selection rectangle (never blocks input) -->
                <Canvas x:Name="MarqueeLayer" Margin="6" IsHitTestVisible="False">
                    <Rectangle x:Name="MarqueeRect"
                               Visibility="Collapsed"
                               Stroke="#7FA8E0" StrokeThickness="1"
                               Fill="#335A8FD8"
                               SnapsToDevicePixels="True"/>
                </Canvas>
            </Grid>
        </DockPanel>
        </Border>
        </Border>
    </Border>
</Window>