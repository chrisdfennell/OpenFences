<Window x:Class="OpenFences.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        Width="420" Height="260">

    <!-- Borderless chrome (resize grips, no caption buttons) -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flat, hover-aware title-bar button (replaces default gray 3D chrome) -->
        <Style x:Key="FenceTitleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C7CBD1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3D44"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4A4E57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A close button that tints red on hover -->
        <Style x:Key="FenceCloseButton" TargetType="Button" BasedOn="{StaticResource FenceTitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Item tile: rounded card that highlights on hover and when selected -->
        <Style x:Key="FenceItemBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#3354708F"/>
                    <Setter Property="BorderBrush" Value="#5A8FD8"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Root surface: rounded dark card + drop shadow -->
    <Border x:Name="RootBorder"
            Background="#1E1E1E"
            CornerRadius="10"
            BorderBrush="#3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.40" Color="#000000"/>
        </Border.Effect>

        <DockPanel>

            <!-- Title bar -->
            <Grid DockPanel.Dock="Top"
                  Height="34"
                  Background="#2B2B2B"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  ContextMenuOpening="TitleBar_ContextMenuOpening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="#E0E0E0"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Content="✎"
                            Style="{StaticResource FenceTitleButton}"
                            Width="28" Height="24" Margin="0,0,4,0"
                            ToolTip="Rename Fence"
                            Click="Rename_Click"/>
                    <Button Content="–"
                            Style="{StaticResource FenceTitleButton}"
                            Width="28" Height="24" Margin="0,0,4,0"
                            Click="Collapse_Click"
                            ToolTip="Collapse / Expand"/>
                    <Button Content="✕"
                            Style="{StaticResource FenceCloseButton}"
                            Width="28" Height="24"
                            Click="Close_Click"
                            ToolTip="Close Fence"/>
                </StackPanel>

                <!-- Right-click menu on the title bar -->
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename…" Click="Rename_Click"/>
                        <MenuItem Header="Open Folder" Click="OpenFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Add System Shortcuts" Click="AddSystemShortcuts_Click"/>
                        <MenuItem Header="Transparency">
                            <MenuItem Header="Opaque"             Tag="1.00" Click="Transparency_Click"/>
                            <MenuItem Header="Slight (90%)"       Tag="0.90" Click="Transparency_Click"/>
                            <MenuItem Header="Medium (75%)"       Tag="0.75" Click="Transparency_Click"/>
                            <MenuItem Header="High (60%)"         Tag="0.60" Click="Transparency_Click"/>
                            <MenuItem Header="Very High (40%)"    Tag="0.40" Click="Transparency_Click"/>
                            <MenuItem Header="Glass (20%)"        Tag="0.20" Click="Transparency_Click"/>
                            <MenuItem Header="Invisible (0%)"     Tag="0.00" Click="Transparency_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete Fence…" Foreground="#FFEF4444" Click="DeleteFence_Click"/>
                        <Separator/>
                        <MenuItem Header="Close Fence" Click="Close_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>

            <!-- Items area -->
            <ScrollViewer x:Name="Scroller"
              Margin="6"
              VerticalScrollBarVisibility="Auto"
              Background="Transparent"
              PreviewMouseWheel="Scroller_PreviewMouseWheel"
              PreviewMouseLeftButtonDown="Scroller_PreviewMouseLeftButtonDown"
              CanContentScroll="False"
              PanningMode="None">

                <ItemsControl x:Name="Items" SnapsToDevicePixels="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Fixed size tiles => stable extent & scrolling -->
                            <WrapPanel ItemWidth="92" ItemHeight="92" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Highlight card; total width matches ItemWidth minus margins (92 - 4 - 4) -->
                            <Border Style="{StaticResource FenceItemBorder}"
                                    Width="84"
                                    Margin="4,4,4,4"
                                    Padding="4,6,4,4"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTip="{Binding DisplayName}"
                                    MouseLeftButtonDown="Item_MouseLeftButtonDown">
                                <StackPanel>
                                    <Image Width="40" Height="40"
                     Source="{Binding Icon}"
                     Stretch="Uniform"
                     SnapsToDevicePixels="True"
                     UseLayoutRounding="True"/>
                                    <!-- Two-line label, like Fences -->
                                    <TextBlock Text="{Binding DisplayName}"
                     Foreground="#EAEAEA"
                     FontSize="11"
                     Margin="0,5,0,0"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     MaxHeight="28"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>