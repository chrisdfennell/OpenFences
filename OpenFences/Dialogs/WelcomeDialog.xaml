<Window x:Class="OpenFences.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to OpenFences"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B20"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One tip: a glyph and a bold lead-in followed by the explanation -->
            <Style x:Key="TipGlyph" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Foreground" Value="{StaticResource Dlg.Accent}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="TipText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="#C9CFDA"/>
                <Setter Property="LineHeight" Value="19"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/OpenFences;component/Assets/open-fence.ico"
                   Width="40" Height="40" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to OpenFences" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Your desktop, sorted into fences." Foreground="{StaticResource Dlg.Subtle}"/>
            </StackPanel>
        </StackPanel>

        <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="10"
                Background="{StaticResource Dlg.Card}" BorderBrush="{StaticResource Dlg.CardEdge}" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="▦"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="#FFFFFF" Text="Your desktop items now live in fences."/>
                        <Run Text="Nothing is moved or copied. Anything not in another fence shows in the Desktop fence, and your normal desktop icons come back when you quit."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⬚"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="#FFFFFF" Text="Right-drag on empty desktop"/>
                        <Run Text="to draw a new fence, then drag items into it. Left-drag selects items across fences."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⇕"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="#FFFFFF" Text="Double-click a fence's title"/>
                        <Run Text="to roll it up; hover over it to peek inside. Right-click the title for color, sorting and more."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel>
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⌨"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="#FFFFFF" Text="Ctrl+Alt+F"/>
                        <Run Text="searches every fence. "/>
                        <Run FontWeight="SemiBold" Foreground="#FFFFFF" Text="Ctrl+Alt+H"/>
                        <Run Text="hides or shows all fences."/>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource Dlg.Subtle}"
                   Text="Want a head start? OpenFences can sort your desktop into Apps, Documents and System fences. You can rearrange everything afterwards."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="I'll set it up myself" Margin="0,0,8,0" IsCancel="True" Click="Skip_Click"/>
            <Button Content="Organize my desktop for me" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Organize_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
