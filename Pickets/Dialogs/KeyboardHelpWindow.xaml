<Window x:Class="Pickets.KeyboardHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts"
        Width="600" Height="640" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Dlg.Bg}"
        Foreground="{DynamicResource Dlg.Fg}"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Keyboard shortcuts" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Dlg.Body}"
                       Text="Press F1 in a fence or in the Pickets window to see this list. The shortcuts that work everywhere can be changed in Settings."/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="110" Margin="0,14,0,0"
                Content="Close" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Sections"/>
        </ScrollViewer>
    </DockPanel>
</Window>
