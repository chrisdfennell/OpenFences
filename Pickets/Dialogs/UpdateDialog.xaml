<Window x:Class="Pickets.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Dlg.Window}"
        Background="{DynamicResource Dlg.Card}"
        Title="Pickets Update"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Buttons (same look as InputDialog) -->

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Dlg.BtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource Dlg.BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Dlg.BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dlg.BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dlg.BtnPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,36,6"/>
            <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Dlg.Body}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="What's new" Foreground="{DynamicResource Dlg.Subtle}" Margin="0,0,0,4"/>
            <TextBox x:Name="NotesBox"
                     IsReadOnly="True"
                     VerticalContentAlignment="Top"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="200"
                     Padding="8"
                     Foreground="{DynamicResource Dlg.InputFg}"
                     Background="{DynamicResource Dlg.InputBg}"
                     BorderBrush="{DynamicResource Dlg.InputEdge}"
                     BorderThickness="1"
                     Margin="0,0,0,12"/>

            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Dlg.Body}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <DockPanel LastChildFill="False">
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip this version" Click="Skip_Click"/>
                <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Install now" Width="130" IsDefault="True" Click="Install_Click"/>
                <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Later" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Later_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
