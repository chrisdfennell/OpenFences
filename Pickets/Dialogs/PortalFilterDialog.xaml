<Window x:Class="Pickets.PortalFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Dlg.Window}"
        Title="Filter portal"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Filter this portal" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource Dlg.Subtle}"
                   Text="Show only some of the folder's contents, e.g. just PDFs, or only what's new. Leave both as they are to show everything."/>

        <TextBlock Text="File names" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="PatternsBox" Height="34"/>
        <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource Dlg.Subtle}"
                   Text="For example: .pdf .docx  or  screenshot*  or  invoice. Subfolders are hidden while a name filter is set."/>

        <TextBlock Text="Changed within" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Button x:Name="AgeButton" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="10,6"
                FontWeight="Normal" Click="AgeButton_Click">
            <DockPanel Width="180">
                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource Dlg.Subtle}"/>
                <TextBlock x:Name="AgeText"/>
            </DockPanel>
        </Button>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Show everything" Click="Clear_Click"/>
            <Button DockPanel.Dock="Right" Content="Save" Width="100" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Width="100" Margin="0,0,8,0" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
