<Window x:Class="Pickets.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Dlg.Window}"
        Title="Welcome to Pickets"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One tip: a glyph and a bold lead-in followed by the explanation -->
            <Style x:Key="TipGlyph" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Foreground" Value="{DynamicResource Dlg.Accent}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="TipText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource Dlg.Body}"/>
                <Setter Property="LineHeight" Value="19"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Pickets;component/Assets/open-fence.ico"
                   Width="40" Height="40" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to Pickets" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Your desktop, sorted into fences." Foreground="{DynamicResource Dlg.Subtle}"/>
            </StackPanel>
        </StackPanel>

        <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="10"
                Background="{DynamicResource Dlg.Card}" BorderBrush="{DynamicResource Dlg.CardEdge}" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="▦"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Dlg.Strong}" Text="Nothing changes until you say so."/>
                        <Run Text="Your desktop stays as it is until you put items in a fence or let Pickets sort it. From then on your desktop items show inside fences (anything not in another fence shows in the Desktop fence). Nothing is moved or copied, and your normal desktop icons come back when you quit."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⬚"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Dlg.Strong}" Text="Right-drag on empty desktop"/>
                        <Run Text="to draw a new fence, then drag items into it. Left-drag selects items across fences."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⇕"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Dlg.Strong}" Text="Double-click a fence's title"/>
                        <Run Text="to roll it up; hover over it to peek inside. Right-click the title for color, sorting and more."/>
                    </TextBlock>
                </DockPanel>
                <DockPanel>
                    <TextBlock Style="{StaticResource TipGlyph}" Text="⌨"/>
                    <TextBlock Style="{StaticResource TipText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Dlg.Strong}" Text="Ctrl+Alt+F"/>
                        <Run Text="searches every fence. "/>
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Dlg.Strong}" Text="Ctrl+Alt+H"/>
                        <Run Text="hides or shows all fences."/>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Dlg.Subtle}"
                   Text="Want a head start? Pickets can sort your desktop into Apps, Documents and System fences. You can rearrange everything afterwards."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="I'll set it up myself" Margin="0,0,8,0" IsCancel="True" Click="Skip_Click"/>
            <Button Content="Organize my desktop for me" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Organize_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
