<!-- Styles for the main window (sidebar, cards, tiles, toggles). Colors match the website. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Hub.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Text ===== -->
    <Style x:Key="Hub.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hub.IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Hub.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>
    <Style x:Key="Hub.PageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Hub.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hub.RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hub.RowText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hub.TileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Hub.Glyph}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Hub.TileTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hub.TileText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Containers ===== -->
    <Style x:Key="Hub.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hub.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Hub.ListRow" TargetType="Border" BasedOn="{StaticResource Hub.Card}">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hub.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Hub.SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="16,12"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>
    <Style x:Key="Hub.RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Hub.Border}"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Hub.ButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hub.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hub.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Hub.ButtonBase}"/>
    <Style x:Key="Hub.RowButton" TargetType="Button" BasedOn="{StaticResource Hub.ButtonBase}">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MinWidth" Value="72"/>
    </Style>
    <Style x:Key="Hub.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Hub.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Hub.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.OnAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hub.DangerButton" TargetType="Button" BasedOn="{StaticResource Hub.ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.DangerEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Danger}"/>
    </Style>
    <Style x:Key="Hub.IconButton" TargetType="Button">
        <!-- Icon-font glyphs mean nothing to a screen reader; the tooltip says what it does -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="{StaticResource Hub.IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hub.IconDangerButton" TargetType="Button" BasedOn="{StaticResource Hub.IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Hub.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Title-bar buttons (minimize / maximize / close) -->
    <Style x:Key="Hub.CaptionButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource Hub.IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.CaptionHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hub.CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource Hub.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick-action tile on the Home page -->
    <Style x:Key="Hub.ActionTile" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="16,16,16,18">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Hub.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation item -->
    <Style x:Key="Hub.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Muted}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Hub.Accent}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hub.AccentSoft}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch (CheckBox) -->
    <Style x:Key="Hub.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="track" CornerRadius="12" Background="{DynamicResource Hub.ToggleTrack}" BorderBrush="{DynamicResource Hub.ToggleEdge}" BorderThickness="1"/>
                        <Ellipse x:Name="thumb" Width="14" Height="14" Fill="{DynamicResource Hub.ToggleThumb}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Hub.Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Hub.Accent}"/>
                            <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource Hub.OnAccent}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,5,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shortcut recorder -->
    <Style x:Key="Hub.HotkeyBox" TargetType="TextBox">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{DynamicResource Hub.Bg}" BorderBrush="{DynamicResource Hub.BorderStrong}"
                            BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Hub.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
