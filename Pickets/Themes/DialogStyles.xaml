<!-- Dark dialog controls (same look as InputDialog). Merge into a dialog's Window.Resources:
     the implicit styles then apply to that dialog only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Pickets">

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Dlg.BtnFg}"/>
        <Setter Property="Background" Value="{DynamicResource Dlg.BtnBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dlg.BtnBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dlg.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dlg.BtnPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action (blue) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Dlg.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dlg.PrimaryEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.OnAccent}"/>
    </Style>

    <!-- Small square icon button (↑ ↓ ✕ ▾) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dlg.InputEdge}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Dlg.InputFg}"/>
        <Setter Property="Background" Value="{DynamicResource Dlg.InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dlg.InputEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Dlg.InputFg}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Dlg.Fg}"/>
    </Style>

    <!-- Close button in the dialog frame's top-right corner -->
    <Style x:Key="Dlg.CloseButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Dlg.Subtle}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#A32417"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless dialog frame: rounded card with a shadow and a close button, no system title bar.
         The top of the card drags the window. Apply on the Window root with
         Style="{DynamicResource Dlg.Window}" (StaticResource can't see Window.Resources from there).
         The dialog's own heading sits under the drag strip; keep the top-right corner clear for the X. -->
    <Style x:Key="Dlg.Window" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource Dlg.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dlg.Fg}"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- Caption = 16px shadow margin + 44px strip at the top of the card -->
                <shell:WindowChrome CaptionHeight="60"
                                    ResizeBorderThickness="20"
                                    GlassFrameThickness="0"
                                    CornerRadius="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid Margin="16">
                        <!-- Shadow on its own layer so the content keeps crisp (ClearType) text -->
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Dlg.CardEdge}" BorderThickness="1">
                            <Grid>
                                <AdornerDecorator>
                                    <ContentPresenter/>
                                </AdornerDecorator>
                                <Button Style="{StaticResource Dlg.CloseButton}" Content="&#xE8BB;"
                                        ToolTip="Close" AutomationProperties.Name="Close"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        local:DialogChrome.ClosesWindow="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
