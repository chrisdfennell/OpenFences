<!-- Dark palette. Every color the app's own windows use lives here, with the same keys as
     Palette.Light.xaml; Services/Theme swaps the two at runtime, so XAML must reference these
     with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pickets window (Themes/HubStyles.xaml). Matches the website. -->
    <SolidColorBrush x:Key="Hub.Bg"           Color="#0E1117"/>
    <SolidColorBrush x:Key="Hub.Sidebar"      Color="#12151C"/>
    <SolidColorBrush x:Key="Hub.Surface"      Color="#161A22"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#1D222D"/>
    <SolidColorBrush x:Key="Hub.Control"      Color="#1C212B"/>
    <SolidColorBrush x:Key="Hub.Border"       Color="#262C38"/>
    <SolidColorBrush x:Key="Hub.BorderStrong" Color="#353D4D"/>
    <SolidColorBrush x:Key="Hub.Text"         Color="#E8EBF2"/>
    <SolidColorBrush x:Key="Hub.Muted"        Color="#9AA3B5"/>
    <SolidColorBrush x:Key="Hub.Accent"       Color="#3B82F6"/>
    <SolidColorBrush x:Key="Hub.OnAccent"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.AccentHover"  Color="#2F6FE0"/>
    <SolidColorBrush x:Key="Hub.AccentSoft"   Color="#1B2A4A"/>
    <SolidColorBrush x:Key="Hub.Danger"       Color="#F87171"/>
    <SolidColorBrush x:Key="Hub.DangerEdge"   Color="#7F1D1D"/>
    <SolidColorBrush x:Key="Hub.Warning"      Color="#F59E0B"/>
    <SolidColorBrush x:Key="Hub.CaptionHover" Color="#222833"/>
    <SolidColorBrush x:Key="Hub.ToggleTrack"  Color="#2A303C"/>
    <SolidColorBrush x:Key="Hub.ToggleEdge"   Color="#4A5366"/>
    <SolidColorBrush x:Key="Hub.ToggleThumb"  Color="#C9CFDA"/>
    <!-- Fence list: state pills and the swatch of a fence with no color -->
    <SolidColorBrush x:Key="Hub.StateShown"   Color="#14532D"/>
    <SolidColorBrush x:Key="Hub.StateClosed"  Color="#2A303C"/>
    <SolidColorBrush x:Key="Hub.StateRolled"  Color="#1B2A4A"/>
    <SolidColorBrush x:Key="Hub.Swatch"       Color="#4A5366"/>

    <!-- Dialogs (Themes/DialogStyles.xaml and the dialogs themselves) -->
    <SolidColorBrush x:Key="Dlg.Bg"        Color="#1B1B20"/>
    <SolidColorBrush x:Key="Dlg.Card"      Color="#26262C"/>
    <SolidColorBrush x:Key="Dlg.CardEdge"  Color="#3B3B46"/>
    <SolidColorBrush x:Key="Dlg.Fg"        Color="#EDEDED"/>
    <SolidColorBrush x:Key="Dlg.Strong"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dlg.Body"      Color="#C9CFDA"/>
    <SolidColorBrush x:Key="Dlg.Subtle"    Color="#A8AEBD"/>
    <SolidColorBrush x:Key="Dlg.BtnBg"     Color="#2D3547"/>
    <SolidColorBrush x:Key="Dlg.BtnHover"  Color="#38425A"/>
    <SolidColorBrush x:Key="Dlg.BtnPress"  Color="#2A344C"/>
    <SolidColorBrush x:Key="Dlg.BtnBorder" Color="#55607A"/>
    <SolidColorBrush x:Key="Dlg.BtnFg"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dlg.InputBg"   Color="#202533"/>
    <SolidColorBrush x:Key="Dlg.InputEdge" Color="#3A4453"/>
    <SolidColorBrush x:Key="Dlg.InputFg"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dlg.Primary"     Color="#2563EB"/>
    <SolidColorBrush x:Key="Dlg.PrimaryEdge" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Dlg.Accent"    Color="#3B82F6"/>

    <!-- Menus, scroll bars and menu check boxes (Themes/DarkMenu.xaml) -->
    <SolidColorBrush x:Key="Menu.Background" Color="#151821"/>
    <SolidColorBrush x:Key="Menu.Bar"        Color="#11141B"/>
    <SolidColorBrush x:Key="Menu.Border"     Color="#242938"/>
    <SolidColorBrush x:Key="Menu.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Menu.Subtle"     Color="#A8AEBD"/>
    <SolidColorBrush x:Key="Menu.ItemHover"  Color="#232A39"/>
    <SolidColorBrush x:Key="Menu.ItemPress"  Color="#2D3547"/>
    <SolidColorBrush x:Key="Menu.Accent"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="Menu.Separator"  Color="#30384A"/>
    <SolidColorBrush x:Key="Menu.BoxBg"      Color="#1E2430"/>
    <SolidColorBrush x:Key="Menu.BoxEdge"    Color="#556079"/>
    <SolidColorBrush x:Key="Menu.Danger"     Color="#EF4444"/>
    <SolidColorBrush x:Key="Scroll.Track"    Color="#10141C"/>
    <SolidColorBrush x:Key="Scroll.Thumb"    Color="#30394B"/>
    <SolidColorBrush x:Key="Scroll.ThumbEdge" Color="#3B4458"/>

    <!-- Search (Ctrl+Alt+F) and Quick Look -->
    <SolidColorBrush x:Key="Search.Bg"       Color="#1B1D23"/>
    <SolidColorBrush x:Key="Search.Edge"     Color="#3B3F4C"/>
    <SolidColorBrush x:Key="Search.InputBg"  Color="#22252E"/>
    <SolidColorBrush x:Key="Search.Hover"    Color="#232A39"/>
    <SolidColorBrush x:Key="Search.Selected" Color="#2D3B57"/>
    <SolidColorBrush x:Key="Search.Hint"     Color="#6E7584"/>
    <SolidColorBrush x:Key="Search.Where"    Color="#8A93A6"/>
    <SolidColorBrush x:Key="QuickLook.Bg"    Color="#F2101319"/>
    <!-- The "Default" swatch in a fence's Color menu -->
    <SolidColorBrush x:Key="Fence.DefaultSwatch" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="QuickLook.Code"  Color="#D6DCE6"/>
</ResourceDictionary>
