<Window x:Class="Pickets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pickets"
        Width="1080" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Hub.Bg}"
        Foreground="{DynamicResource Hub.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Borderless window; the top 40px act as the title bar (drag, double-click to maximize). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HubStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Hub.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Hub.Sidebar}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Pickets;component/Assets/open-fence.ico" Width="18" Height="18"/>
                    <TextBlock Text="Pickets" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Hub.CaptionButton}" Content="&#xE921;" ToolTip="Minimize to tray"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource Hub.CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource Hub.CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Quit Pickets"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Hub.Sidebar}" BorderBrush="{DynamicResource Hub.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource Hub.SecondaryButton}" HorizontalAlignment="Stretch" Click="MinimizeButton_Click"
                            ToolTip="Keep Pickets running in the tray">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Hub.Glyph}" Text="&#xE73F;" Margin="0,0,8,0"/>
                            <TextBlock Text="Hide to tray"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SidebarVersion" Margin="4,12,0,0" FontSize="12" Foreground="{DynamicResource Hub.Muted}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource Hub.NavItem}" GroupName="Nav" IsChecked="True" Tag="Home" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Hub.Glyph}" Text="&#xE80F;" Margin="0,0,12,0"/>
                            <TextBlock Text="Home"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Hub.NavItem}" GroupName="Nav" Tag="Settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Hub.Glyph}" Text="&#xE713;" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource Hub.NavItem}" GroupName="Nav" Tag="About" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Hub.Glyph}" Text="&#xE946;" Margin="0,0,12,0"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Pages ===== -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="36,28,36,36" MaxWidth="980" HorizontalAlignment="Stretch">

                <!-- ===================== HOME ===================== -->
                <StackPanel x:Name="HomePage">
                    <DockPanel>
                        <Button x:Name="ProfileButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                                Style="{StaticResource Hub.SecondaryButton}" Click="ProfileButton_Click"/>
                        <StackPanel>
                            <TextBlock Text="Your fences" Style="{StaticResource Hub.PageTitle}"/>
                            <TextBlock x:Name="SummaryText" Style="{StaticResource Hub.PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Columns="3" Margin="-6,22,-6,0">
                        <Button Style="{StaticResource Hub.ActionTile}" Click="NewFence_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE710;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="New fence"/>
                                <TextBlock Style="{StaticResource Hub.TileText}" Text="An empty fence at your mouse pointer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Hub.ActionTile}" Click="NewFolderPortal_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="New folder portal"/>
                                <TextBlock Style="{StaticResource Hub.TileText}" Text="A live view of any folder"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Hub.ActionTile}" Click="NewSystemMonitor_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE9D9;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="System monitor"/>
                                <TextBlock Style="{StaticResource Hub.TileText}" Text="Live CPU, memory, disk and network"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Hub.ActionTile}" Click="RecentFiles_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE81C;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="Recent files"/>
                                <TextBlock Style="{StaticResource Hub.TileText}" Text="A fence of what you opened lately"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Hub.ActionTile}" Click="AutoImportDesktop_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE945;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="Auto-import desktop"/>
                                <TextBlock Style="{StaticResource Hub.TileText}" Text="Sort into Apps, Documents and System"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Hub.ActionTile}" Click="Search_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hub.TileGlyph}" Text="&#xE721;"/>
                                <TextBlock Style="{StaticResource Hub.TileTitle}" Text="Search fences"/>
                                <TextBlock x:Name="SearchTileHint" Style="{StaticResource Hub.TileText}" Text="Find any item"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <DockPanel Margin="0,32,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ToggleAllButton" Style="{StaticResource Hub.SecondaryButton}" Click="ToggleAllFences_Click"/>
                            <Button Style="{StaticResource Hub.SecondaryButton}" Margin="8,0,0,0" Content="Show desktop icons" Click="ToggleDesktopIcons_Click"
                                    ToolTip="Show or hide Windows' own desktop icons behind the fences"/>
                        </StackPanel>
                        <TextBlock Text="Fences" Style="{StaticResource Hub.SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ItemsControl x:Name="FenceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Hub.ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="12" Height="36" CornerRadius="4" Background="{Binding Swatch}" Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Hub.Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource Hub.Pill}" Background="{Binding StateBrush}" Margin="12,0">
                                            <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource Hub.RowButton}" Content="{Binding ShowLabel}" Click="FenceRow_ShowClose_Click" Tag="{Binding}"/>
                                            <Button Style="{StaticResource Hub.IconButton}" Content="&#xE7B3;" ToolTip="Locate on screen" Click="FenceRow_Locate_Click" Tag="{Binding}"/>
                                            <Button Style="{StaticResource Hub.IconDangerButton}" Content="&#xE74D;" ToolTip="Delete fence…" Click="FenceRow_Delete_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Hub.Card}" Margin="0,18,0,0" Padding="16,12">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Hub.Muted}">
                            <Run Foreground="{DynamicResource Hub.Text}" FontWeight="SemiBold" Text="Tips:"/>
                            <Run Text="right-drag on empty desktop to draw a fence · double-click a title to roll it up · right-click a title for colors, backgrounds and more."/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- ===================== SETTINGS ===================== -->
                <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                    <TextBlock Text="Settings" Style="{StaticResource Hub.PageTitle}"/>
                    <TextBlock Text="Changes apply right away." Style="{StaticResource Hub.PageSubtitle}"/>

                    <!-- General -->
                    <TextBlock Text="General" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}"
                                        Margin="16,0,0,0" MinWidth="150" Click="ThemeButton_Click"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Theme"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Light or dark look for this window, menus and fences. System follows your Windows setting."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding RunAtStartup}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Start with Windows"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Open Pickets when you sign in."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding DoubleClickPeekFences}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Double-click the desktop to hide fences"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Double-click empty desktop to hide or show all fences."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding DoubleClickDesktopToToggleIcons}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Double-click the desktop to show desktop icons"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Also toggles Windows' own desktop icons behind the fences."/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fences -->
                    <TextBlock Text="Fences" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding SnapToEdges}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Snap to screen edges and other fences"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Hold Alt while dragging to move freely."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding SnapToGrid}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Snap to a grid"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Line fences up on a 20-pixel grid."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding MoveStacksTogether}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Keep stacked fences together"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Fences snapped one under another move as a stack, and rolling one up pulls the ones below it up. Hold Alt to drag a fence out of its stack."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding StackOneOpen}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="One open fence per stack"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Opening a fence in a stack rolls the others up. Works with Keep stacked fences together."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding ExpandCollapsedOnHover}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Open rolled-up fences on hover"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Rest the mouse on a rolled-up fence to peek inside."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding ShowThumbnails}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Show picture and video thumbnails"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Previews instead of generic file icons."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding HideFileExtensions}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Hide file extensions"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Show “Budget” instead of “Budget.xlsx”."/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts -->
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding GlobalHotkeys}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Use global shortcuts"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="They work from any app, even while Pickets is in the tray."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <TextBox x:Name="SearchHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource Hub.HotkeyBox}" Tag="Search"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Search fences"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Click the box, then press the new shortcut."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <TextBox x:Name="ToggleHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource Hub.HotkeyBox}" Tag="Toggle"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Hide or show all fences"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Use Ctrl, Alt, Shift or Win plus a key."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <TextBox x:Name="FrontHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource Hub.HotkeyBox}" Tag="Front"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Bring fences in front of windows"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Use your fences without minimizing anything. Click another window or press Esc to put them back."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <TextBox x:Name="ProfileHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource Hub.HotkeyBox}" Tag="Profile"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Next desktop profile"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Switch to your next set of fences (profiles are on the Home page)."/></StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="HotkeyStatus" Margin="16,0,16,14" TextWrapping="Wrap" Foreground="{DynamicResource Hub.Warning}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Organizing -->
                    <TextBlock Text="Organizing" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding AutoOrganize}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Auto-organize new desktop items"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="New files go to a fence chosen by your rules."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Content="Edit rules…" Click="EditRules_Click"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Rules"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Choose which fence apps, folders and file types go to."/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- System monitor -->
                    <DockPanel x:Name="MonitorSection" Margin="0,26,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Content="New system monitor" Click="NewSystemMonitor_Click"/>
                        <TextBlock Text="System monitor" Style="{StaticResource Hub.SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button x:Name="MonitorIntervalButton" DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Click="MonitorInterval_Click"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Update every"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="How often monitors take new readings. Less often uses a little less power."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button x:Name="MonitorHistoryButton" DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Click="MonitorHistory_Click"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Graph length"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="How much recent history the graphs show."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding MonitorNetworkBits}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Show speeds in bits"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Network and disk speeds in Mbps, like internet plans, instead of MB/s."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding MonitorWarnColors}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Warning colors"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Readings turn amber, then red, when the CPU, GPU or memory is busy, a drive is nearly full or the battery is low."/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Hub.Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button x:Name="MonitorPickButton" DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Click="MonitorPick_Click"
                                        AutomationProperties.Name="Monitor to edit"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Tiles"/>
                                    <TextBlock x:Name="MonitorTilesHint" Style="{StaticResource Hub.RowText}"/></StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="MonitorTileList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Style="{StaticResource Hub.RowDivider}"/>
                                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GraphWord}" Visibility="{Binding GraphVisibility}" Foreground="{DynamicResource Hub.Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <CheckBox Style="{StaticResource Hub.Toggle}" IsChecked="{Binding Graph, Mode=TwoWay}" Visibility="{Binding GraphVisibility}"
                                                              ToolTip="{Binding GraphName}" AutomationProperties.Name="{Binding GraphName}"
                                                              Margin="0,0,10,0"/>
                                                    <Button Style="{StaticResource Hub.IconButton}" Content="&#xE70E;" ToolTip="Move up" Visibility="{Binding UpVisibility}"
                                                            AutomationProperties.Name="{Binding MoveUpName}" Click="MonitorTileUp_Click" Tag="{Binding}"/>
                                                    <Button Style="{StaticResource Hub.IconButton}" Content="&#xE70D;" ToolTip="Move down" Visibility="{Binding DownVisibility}"
                                                            AutomationProperties.Name="{Binding MoveDownName}" Click="MonitorTileDown_Click" Tag="{Binding}"/>
                                                    <Button Style="{StaticResource Hub.IconButton}" Content="&#xE8AC;" ToolTip="Rename"
                                                            AutomationProperties.Name="{Binding RenameName}" Click="MonitorTileRename_Click" Tag="{Binding}"/>
                                                    <Button Style="{StaticResource Hub.IconDangerButton}" Content="&#xE74D;" ToolTip="Remove tile"
                                                            AutomationProperties.Name="{Binding RemoveName}" Click="MonitorTileRemove_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="{Binding Title}"/>
                                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="{Binding Details}"/></StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="MonitorAddDivider" Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel x:Name="MonitorAddRow" Style="{StaticResource Hub.SettingRow}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Hub.SecondaryButton}" Content="Reset" Click="MonitorReset_Click"
                                            ToolTip="Go back to the usual tiles"/>
                                    <Button x:Name="MonitorAddButton" Style="{StaticResource Hub.PrimaryButton}" Margin="8,0,0,0" Content="Add tile  ▾" Click="MonitorAdd_Click"/>
                                </StackPanel>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Add a tile"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Readings this PC can't give are greyed out. You can also right-click a tile on the monitor."/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Layouts -->
                    <DockPanel Margin="0,26,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Hub.SecondaryButton}" Content="Open folder" Click="OpenLayoutsFolder_Click"/>
                            <Button Style="{StaticResource Hub.PrimaryButton}" Margin="8,0,0,0" Content="Save current layout…" Click="SaveLayout_Click"/>
                        </StackPanel>
                        <TextBlock Text="Layouts" Style="{StaticResource Hub.SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <TextBlock x:Name="NoLayoutsText" Margin="16,14" Foreground="{DynamicResource Hub.Muted}"
                                       Text="No saved layouts yet. Pickets also saves one automatically before big changes."/>
                            <ItemsControl x:Name="LayoutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Style="{StaticResource Hub.SettingRow}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Hub.RowButton}" Content="Restore" Click="LayoutRestore_Click" Tag="{Binding Snapshot}"/>
                                                <Button Style="{StaticResource Hub.IconDangerButton}" Content="&#xE74D;" ToolTip="Delete this layout" Click="LayoutDelete_Click" Tag="{Binding Snapshot}"/>
                                            </StackPanel>
                                            <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="{Binding Title}"/>
                                                <TextBlock Style="{StaticResource Hub.RowText}" Text="{Binding Details}"/></StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Hub.Card}" Margin="0,8,0,0">
                        <DockPanel Style="{StaticResource Hub.SettingRow}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Hub.SecondaryButton}" Content="Import…" Click="ImportLayout_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="8,0,0,0" Content="Export…" Click="ExportLayout_Click"/>
                            </StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Move to another PC"/>
                                <TextBlock Style="{StaticResource Hub.RowText}" Text="Export your fences and rules to a file, then import it on the other PC. Items in your desktop and user folders are found there too."/></StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Updates -->
                    <TextBlock Text="Updates" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Hub.Toggle}" IsChecked="{Binding CheckForUpdates}" Click="Setting_Changed"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Check for updates automatically"/>
                                    <TextBlock Style="{StaticResource Hub.RowText}" Text="Asks GitHub for new versions at startup and once a day."/></StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Hub.RowDivider}"/>
                            <DockPanel Style="{StaticResource Hub.SettingRow}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Hub.SecondaryButton}" Content="Check now" Click="CheckForUpdatesNow_Click"/>
                                <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Current version"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Hub.RowText}"/></StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reset -->
                    <TextBlock Text="Start over" Style="{StaticResource Hub.SectionTitle}" Margin="0,26,0,10"/>
                    <Border Style="{StaticResource Hub.Card}">
                        <DockPanel Style="{StaticResource Hub.SettingRow}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Hub.DangerButton}" Content="Delete all fences…" Click="DeleteAllFences_Click"/>
                            <StackPanel><TextBlock Style="{StaticResource Hub.RowTitle}" Text="Delete all fences"/>
                                <TextBlock Style="{StaticResource Hub.RowText}" Text="Everything goes back into one Desktop fence. The current layout is saved first."/></StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== ABOUT ===================== -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <Border Style="{StaticResource Hub.Card}" Padding="28">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Pickets;component/Assets/open-fence.ico" Width="64" Height="64"/>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Pickets" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Hub.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hub.Muted}" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="A free, open-source app that organizes your Windows desktop into movable, resizable fences. Your files stay where they are; fences only decide where each item is shown."/>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Website" Tag="https://chrisdfennell.github.io/Pickets/" Click="Link_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Source code on GitHub" Tag="https://github.com/chrisdfennell/Pickets" Click="Link_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Report a problem" Tag="https://github.com/chrisdfennell/Pickets/issues" Click="Link_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Privacy policy" Tag="https://chrisdfennell.github.io/Pickets/privacy.html" Click="Link_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Welcome tour" Click="Welcome_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Keyboard shortcuts" Click="KeyboardHelp_Click"/>
                                <Button Style="{StaticResource Hub.SecondaryButton}" Margin="0,0,8,8" Content="Copy diagnostics" Click="CopyDiagnostics_Click"
                                        ToolTip="Copy a summary for a bug report: version, Windows, monitors, settings and recent errors. Your name and fence names are left out."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="4,18,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hub.Muted}"
                               Text="© Christopher Fennell · MIT license · Not affiliated with or endorsed by Stardock. “Fences” is a trademark of its respective owner."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
