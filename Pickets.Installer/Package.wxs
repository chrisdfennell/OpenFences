<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Two installers from this file (Pickets.Installer.wixproj, PerUser):
         - Pickets-<arch>.msi: for everyone on the PC, in Program Files (asks for admin rights).
         - Pickets-<arch>-user.msi: just for the current user, in %LocalAppData%\Programs (no prompt).
       Each has its own UpgradeCode, FIXED for the life of the product (do not change them): an
       install only upgrades the same kind, and Windows can't turn one kind into the other. -->
  <?if $(var.PerUser) = true ?>
    <?define Scope = "perUser" ?>
    <?define UpgradeCode = "5F1D3C9A-7B2E-4E84-A6C1-0D9B8E2F4A71" ?>
  <?else?>
    <?define Scope = "perMachine" ?>
    <?define UpgradeCode = "B8E7B0C2-2F4A-4C9E-9D3F-7A1E6C5D4B30" ?>
  <?endif?>

  <Package Name="Pickets"
           Manufacturer="Fennell"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="$(var.Scope)"
           Compressed="yes">

    <SummaryInformation Description="Pickets — lightweight desktop fences for Windows" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Assets\open-fence.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/chrisdfennell/Pickets" />

    <!-- Install location: Program Files\Pickets, or just for you %LocalAppData%\Programs\Pickets
         (where per-user apps such as VS Code go). -->
    <?if $(var.PerUser) = true ?>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Pickets" />
      </Directory>
    </StandardDirectory>
    <?else?>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Pickets" />
    </StandardDirectory>
    <?endif?>

    <Feature Id="Main" Title="Pickets" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Desktop shortcut: on unless unticked in setup, or DESKTOPSHORTCUT=0 on a silent install
         (msiexec /i Pickets-x64.msi /qn DESKTOPSHORTCUT=0). Secure so the choice reaches the
         elevated install. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Harvest the entire published app folder (self-contained build). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartShortcut"
                  Name="Pickets"
                  Description="Lightweight desktop fences for Windows"
                  Target="[INSTALLFOLDER]Pickets.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <!-- Recovery: brings the desktop icons back if Pickets crashed while they were hidden. -->
        <Shortcut Id="RestoreIconsShortcut"
                  Name="Pickets - Restore desktop icons"
                  Description="Show your desktop icons again if Pickets stopped unexpectedly"
                  Target="[INSTALLFOLDER]Pickets.exe"
                  Arguments="--restore-icons"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Fennell\Pickets"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Desktop shortcut (your desktop, or everyone's for the all-users installer) -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopAppShortcut"
                  Name="Pickets"
                  Description="Lightweight desktop fences for Windows"
                  Target="[INSTALLFOLDER]Pickets.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Fennell\Pickets"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Setup wizard: Welcome → Options (desktop shortcut) → Install → Finish. -->
    <UI Id="PicketsUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose how Pickets is set up on this PC." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Options" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="18"
                 Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />

  </Package>
</Wix>
